# Copy to .env on the VM and fill in. python-decouple reads it automatically.
SECRET_KEY=generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your.domain.or.vm.ip
REDIS_URL=redis://localhost:6379

# Error reporting (leave empty to disable)
SENTRY_DSN=
SENTRY_ENV=production

# Report digest (cron: manage.py report_digest)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
REPORT_DIGEST_EMAIL=tsargentmoore@gmail.com

# Feature gates
ALLOW_IMAGE_POSTS=False

# S3 media (public-read bucket; leave USE_S3 empty to use VM disk)
USE_S3=True
AWS_STORAGE_BUCKET_NAME=cmim-media-195275646962
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
